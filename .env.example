PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=0
DATABASE_URL=mysql://instagram:instagram@127.0.0.1:3306/instagram_downloader
DOWNLOAD_DIR=./storage/downloads
ARCHIVE_DIR=./storage/archives
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_TIMEOUT_MS=180000
GALLERY_DL_BIN=gallery-dl
# Opsional: file cookies Netscape untuk konten yang membutuhkan sesi Instagram.
# INSTAGRAM_COOKIES_FILE=/run/secrets/instagram-cookies.txt
