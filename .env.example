PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=0
DATABASE_URL=mysql://instagram:instagram@127.0.0.1:3306/instagram_downloader
DOWNLOAD_DIR=./storage/downloads
ARCHIVE_DIR=./storage/archives
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_TIMEOUT_MS=600000
DOWNLOAD_DEBUG=0
INSTAGRAM_PROVIDER=auto
GALLERY_DL_BIN=gallery-dl
# Opsional: file cookies Netscape untuk konten yang membutuhkan sesi Instagram.
# Saat provider gallery-dl aktif tanpa file ini, postingan publik memakai API GraphQL.
# INSTAGRAM_COOKIES_FILE=/run/secrets/instagram-cookies.txt
# Mode tanpa cookies Instagram: buat token Apify lalu isi dua variabel berikut.
# APIFY_TOKEN=
# APIFY_INSTAGRAM_ACTOR=apify~instagram-api-scraper
